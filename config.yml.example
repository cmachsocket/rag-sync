# 要同步的目录。每个目录配一个唯一的别名：产物落在 output_dir/<别名>/ 下，
# 上传给 LightRAG 的文件名前缀也是它（<别名>__<文件名>）。
# 别名不能含 / \ 空格或 __，目录之间不能重叠 —— 这两类问题启动时就会报错。
sync_folders:
  - name: "work"          # 别名
    path: "~/Documents/work"
  - name: "personal"
    path: "~/Documents/personal"

output_dir: "~/MinerU"    # 所有别名共用一个产物目录
mineru_url: "http://127.0.0.1:9777"
lightrag_url: "http://127.0.0.1:9778"
lightrag_username: "admin"
lightrag_password: "admin"

# 转换（透传 / MinerU 解析）与上传（LightRAG）是两步，两步本来就并行：
# 上传一个文件时，下一个文件已经在解析了。下面两个是「每一步内部」再并发几份。
# 默认都是 1 —— 调高之前先看 readme 里那两条代价。
mineru_concurrency: 1     # 同时解析几个文件
lightrag_concurrency: 1   # 同时上传几个文件

# Joplin 笔记同步。去掉这一整段就不做 Joplin 同步。
# 笔记取到直接进知识库，不在本地落盘；游标存在库里，下一轮只取新增的变更。
joplin:
  url: "http://127.0.0.1:9779"
  email: "user@example.com"
  password: "password"
  alias: "joplin"        # 上传文件名的前缀：joplin__<item_name>
  limit: 100             # delta 每页取几条变更事件
